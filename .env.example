# 面经阁 环境变量示例（占位值，请勿直接使用）
# 使用方法：cp .env.example .env，把下面的占位值改成你自己的真实值
# .env 已加入 .gitignore，永远不会提交到仓库

# MySQL（docker-compose 使用）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# 后端（application-dev.yml / application-prod.yml 使用）
# JWT 密钥：HS256 需要至少 64 位随机字符，可用 `openssl rand -hex 64` 生成
MJ_JWT_SECRET=change-me-64-char-random-secret
MJ_ADMIN_INIT_PASSWORD=change-me-admin-password
